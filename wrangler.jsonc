// Cloudflare Workers config. Cloudflare runs `npm run build`, then `npx wrangler deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard
  "name": "music-website",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Keep the music-website.<account>.workers.dev test address
  "workers_dev": true,
  "preview_urls": true,
  // noahsax.com and www (www redirects to the bare domain in worker/index.js)
  "routes": [
    { "pattern": "noahsax.com", "custom_domain": true },
    { "pattern": "www.noahsax.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    // Unknown paths like /bio load index.html and React Router takes over
    "not_found_handling": "single-page-application",
    // Send API calls to the Worker instead of the static files
    "run_worker_first": ["/api/*"]
  },
  // Keep variables set in the dashboard when deploying
  "keep_vars": true,
  "observability": { "enabled": true }
}
